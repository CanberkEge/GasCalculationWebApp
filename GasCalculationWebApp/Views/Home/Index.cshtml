<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gas Calculation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <header>
        <div class="logo">
            <h1>Gas Calculation</h1>
        </div>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h2>Fuel Calculator</h2>
            <p>Calculate fuel consumption and costs effortlessly.</p>
        </div>
    </section>



    <!-- Manuel Yakıt Tüketimi Hesaplama Formu -->
    <section class="form-section">
        <h3>Calculate Fuel Costs (Manual Input)</h3>
        <form method="post" action="/Home/Calculate" class="form">
            <div class="form-group">
                <label for="fuelType">Fuel Type:</label>
                <select id="fuelType" name="fuelType">
                    <option value="benzin">Benzin</option>
                    <option value="dizel">Dizel</option>
                    <option value="lpg">LPG</option>
                </select>
            </div>
            <div class="form-group">
                <label for="distance">Distance (km):</label>
                <input type="text" id="distance" name="distance" required />
            </div>
            <div class="form-group">
                <label for="averageGasSpend">Average Gas Spend (liters per 100 km):</label>
                <input type="text" id="averageGasSpend" name="averageGasSpend" required />
            </div>
            <button type="submit" class="btn">Calculate</button>
        </form>
    </section>

    <section class="result-section">
        <h3>Manual Input Results</h3>
        <div id="result">
            @if (ViewBag.Result != null)
            {
                <p>@Html.Raw(ViewBag.Result)</p>
            }
        </div>
    </section>

    <!-- Car Selection Form -->
    <section class="form-section">
        <h3>Calculate Fuel Costs (Car Selection)</h3>
        <form method="post" action="/Home/CalculateByCar" class="form">
            <div class="form-group">
                <label for="brand">Brand:</label>
                <select id="brand" name="brand" onchange="loadModels()" required>
                    <option value="">Select Brand</option>
                    @if (ViewBag.Brands != null && ViewBag.Brands is List<string>)
                        {
                    foreach (var brand in ViewBag.Brands as List<string>)
                    {
                        <option value="@brand">@brand</option>
                    }
                        }
                    else
                    {
                    <option value="">No brands available</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="model">Model:</label>
                <select id="model" name="model" onchange="loadGenerations()" required>
                    <option value="">Select Model</option>
                </select>
            </div>
            <div class="form-group">
                <label for="generation">Generation:</label>
                <select id="generation" name="generation" onchange="loadYears()" required>
                    <option value="">Select Generation</option>
                </select>
            </div>
            <div class="form-group">
                <label for="year">Year:</label>
                <select id="year" name="year" onchange="loadEngines()" required>
                    <option value="">Select Year</option>
                </select>
            </div>
            <div class="form-group">
                <label for="engine">Engine:</label>
                <select id="engine" name="engine" onchange="loadFuelTypes()" required>
                    <option value="">Select Engine</option>
                </select>
            </div>
            <div class="form-group">
                <label for="fuel">Fuel:</label>
                <select id="fuel" name="fuel"  required>
                    <option value="">Select Fuel Type</option>
                </select>
            </div>

            <div id="city-consumption-container">
                <span id="city-consumption">City Consumption: Not available</span>
            </div>

            <div class="form-group">
                <label for="distanceCar">Distance (km):</label>
                <input type="text" id="distanceCar" name="distance" required />
            </div>
            <button type="submit" class="btn">Calculate</button>
        </form>
    </section>

    <section class="result-section">
        <h3>Car Selection Results</h3>
        <div id="car-result">
            @if (ViewBag.CarResult != null)
            {
                <p>@Html.Raw(ViewBag.CarResult)</p>
            }
            else
            {
                <p style="color: red;">Select a car to see the fuel consumption.</p>
            }
            
        </div>
    </section>

    <footer>
        <p>© 2025 Gas Calculation. All Rights Reserved.</p>
    </footer>

    <!-- Dinamik Dropdown ve CityConsumption JavaScript -->
    <script>
        // City consumption'ı güncelleyen fonksiyon
        function updateCityConsumption() {
            const brand = document.getElementById('brand').value;
            const model = document.getElementById('model').value;
            const generation = document.getElementById('generation').value;
            const year = document.getElementById('year').value;
            const engine = document.getElementById('engine').value;
            const fuel = document.getElementById('fuel').value;

            // Seçilen tüm parametrelerin dolu olup olmadığını kontrol et
            if (brand && model && generation && year && engine && fuel) {
                console.log(`Fetching city consumption for: ${brand}, ${model}, ${generation}, ${year}, ${engine}, ${fuel}`);
                fetch(`/Home/GetCityConsumption?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}&generation=${encodeURIComponent(generation)}&year=${encodeURIComponent(year)}&engine=${encodeURIComponent(engine)}&fuel=${encodeURIComponent(fuel)}`)
                    .then(response => response.json())
                    .then(data => {
                        console.log('City consumption data:', data);
                        // CityConsumption verisini ekranda göster
                        if (data && data.cityConsumption) 
                        {
                    document.getElementById('city-consumption').textContent = `City Consumption: ${data.cityConsumption} L/100km`;
                }

                else {
                    document.getElementById('city-consumption').textContent = "City Consumption: Not available";
                }
                        
                    })
                    .catch(error => {console.error("Error fetching city consumption:", error);
                    document.getElementById('city-consumption').textContent = "City Consumption: Error fetching data";
            });
                   }
                   else {
                   // Veriler eksikse, CityConsumption'ı "Not available" olarak bırak
                document.getElementById('city-consumption').textContent = "City Consumption: Not available";
            }
            }
            
        

                
        

        // Marka seçildiğinde modelleri yükle
        function loadModels() {
            const brand = document.getElementById('brand').value;
            const modelSelect = document.getElementById('model');
            modelSelect.innerHTML = '<option value="">Select Model</option>';

            fetch(`/Home/GetModels?brand=${encodeURIComponent(brand)}`)
                .then(response => response.json())
                .then(models => {
                    if (models.length === 1 && models[0] === "No models available") {
                        modelSelect.innerHTML = '<option value="">No models available</option>';
                    } else {
                        models.forEach(model => {
                            const option = document.createElement('option');
                            option.value = model;
                            option.textContent = model;
                            modelSelect.appendChild(option);
                        });
                    }
                    updateCityConsumption();  // Model seçildikten sonra city consumption'ı güncelle
                })
                .catch(error => console.error("Error loading models:", error));
        }

        // Model seçildiğinde nesilleri yükle
        function loadGenerations() {
            const brand = document.getElementById('brand').value;
            const model = document.getElementById('model').value;
            const generationSelect = document.getElementById('generation');
            generationSelect.innerHTML = '<option value="">Select Generation</option>';

            fetch(`/Home/GetGenerations?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}`)
                .then(response => response.json())
                .then(generations => {
                    if (generations.length === 1 && generations[0] === "No generations available") {
                        generationSelect.innerHTML = '<option value="">No generations available</option>';
                    } else {
                        generations.forEach(generation => {
                            const option = document.createElement('option');
                            option.value = generation;
                            option.textContent = generation;
                            generationSelect.appendChild(option);
                        });
                    }
                    updateCityConsumption();  // Nesil seçildikten sonra city consumption'ı güncelle
                })
                .catch(error => console.error("Error loading generations:", error));
        }

        // Nesil seçildiğinde yılları yükle
        function loadYears() {
            const brand = document.getElementById('brand').value;
            const model = document.getElementById('model').value;
            const generation = document.getElementById('generation').value;
            const yearSelect = document.getElementById('year');
            yearSelect.innerHTML = '<option value="">Select Year</option>';

            fetch(`/Home/GetYears?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}&generation=${encodeURIComponent(generation)}`)
                .then(response => response.json())
                .then(years => {
                    if (years.length === 1 && years[0] === "No years available") {
                        yearSelect.innerHTML = '<option value="">No years available</option>';
                    } else {
                        years.forEach(year => {
                            const option = document.createElement('option');
                            option.value = year;
                            option.textContent = year;
                            yearSelect.appendChild(option);
                        });
                    }
                    updateCityConsumption();  // Yıl seçildikten sonra city consumption'ı güncelle
                })
                .catch(error => console.error("Error loading years:", error));
        }

        // Yıl seçildiğinde motorları yükle
        function loadEngines() {
            const brand = document.getElementById('brand').value;
            const model = document.getElementById('model').value;
            const generation = document.getElementById('generation').value;
            const year = document.getElementById('year').value;
            const engineSelect = document.getElementById('engine');
            engineSelect.innerHTML = '<option value="">Select Engine</option>';

            fetch(`/Home/GetEngines?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}&generation=${encodeURIComponent(generation)}&year=${encodeURIComponent(year)}`)
                .then(response => response.json())
                .then(engines => {
                    if (engines.length === 1 && engines[0] === "No engines available") {
                        engineSelect.innerHTML = '<option value="">No engines available</option>';
                    } else {
                        engines.forEach(engine => {
                            const option = document.createElement('option');
                            option.value = engine;
                            option.textContent = engine;
                            engineSelect.appendChild(option);
                        });
                    }
                    updateCityConsumption();  // Motor seçildikten sonra city consumption'ı güncelle
                })
                .catch(error => console.error("Error loading engines:", error));
        }

        // Motor seçildiğinde yakıt türlerini yükle
        function loadFuelTypes() {
            const brand = document.getElementById('brand').value;
            const model = document.getElementById('model').value;
            const generation = document.getElementById('generation').value;
            const year = document.getElementById('year').value;
            const engine = document.getElementById('engine').value;
            const fuelSelect = document.getElementById('fuel');
            fuelSelect.innerHTML = '<option value="">Select Fuel Type</option>';

            fetch(`/Home/GetFuelTypes?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}&generation=${encodeURIComponent(generation)}&year=${encodeURIComponent(year)}&engine=${encodeURIComponent(engine)}`)
                .then(response => response.json())
                .then(fuels => {
                    if (fuels.length === 1 && fuels[0] === "No fuel types available") {
                        fuelSelect.innerHTML = '<option value="">No fuel types available</option>';
                    } else {
                        fuels.forEach(fuel => {
                            const option = document.createElement('option');
                            option.value = fuel;
                            option.textContent = fuel;
                            fuelSelect.appendChild(option);
                        });
                    }
                    updateCityConsumption();  // Yakıt seçildikten sonra city consumption'ı güncelle
                })
                .catch(error => console.error("Error loading fuel types:", error));
        }
    </script>



   
</body>
</html>
