<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gas Calculation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css">
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Pictures/GasStation.ico" />
</head>
<body>
    <header>
        <div class="logo">
            <h1>Gas Calculation</h1>
        </div>
    </header>


    <nav>
        <ul>
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("CarIndex", "Home")">Calculate by Car</a></li>

            @if (User.Identity.IsAuthenticated)
            {
                <li>Welcome, @User.Identity.Name!</li>


                <li><a href="@Url.Action("MyCars", "Car")">My Cars</a></li>
                <li><a href="@Url.Action("SaveCar", "Car")">Save Car</a></li>
                <li><a href="@Url.Action("CompareCars", "Car")"><i class="fas fa-balance-scale"></i> Compare Cars</a></li>
                <li><a href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i> Profile</a></li> <!-- Profil linki eklendi -->
                <li><a href="@Url.Action("Logout", "Account")">Logout</a></li>
                
                


                
            }
            else
            {
                <li><a href="@Url.Action("Login", "Account")">Login</a></li>
                <li><a href="@Url.Action("Register", "Account")">Register</a></li>
            }


        </ul>
    </nav>


    


    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }




    <section class="hero">
        <div class="hero-content">
            <h2>Fuel Calculator</h2>
            <p>Calculate fuel consumption and costs effortlessly.</p>
        </div>
    </section>



    <!-- Manuel Yakıt Tüketimi Hesaplama Formu -->
    
    <section class="form-section">
        <h3>Calculate Fuel Costs (Manual Input)</h3>
        <form method="post" action="/Home/Calculate" class="form" onsubmit="return handleSubmit(this);">
            
            <div class="form-group">
                <label for="fuelType">Fuel Type:</label>
                <select id="fuelType" name="fuelType">
                    <option value="benzin">Gasoline</option>
                    <option value="dizel">Diesel</option>
                    <option value="lpg">LPG</option>
                </select>
            </div>
            <div class="form-group">
                <label for="distance">Distance (km):</label>
                <input type="text" id="distance" name="distance" required />
            </div>
            <div class="form-group">
                <label for="averageGasSpend">Average Gas Spend (liters per 100 km):</label>
                <input type="text" id="averageGasSpend" name="averageGasSpend" required />
            </div>


            <!-- Yeni input alanı: Kaç kez yolculuk yapılacağını soruyoruz -->
            <div class="form-group">
                <label for="tripCount">How many times will this trip be made?</label>
                <input type="number" id="tripCount" name="tripCount" class="form-control" value="1" min="1" required>
            </div>
            <button type="submit" class="btn">Calculate</button>
        </form>
    </section>

    <section class="result-section" id="result-section">
        
         
        <h3>Manual Input Results</h3>

        

        
        <div id="result">
            @if (ViewBag.Result != null)
            {
                <p>@Html.Raw(ViewBag.Result)</p>
            }
        </div>
        
    </section>

    
    
        <script>
        // Girdi alanlarına nokta formatlama eklemek için ortak bir fonksiyon
        function formatNumberInput(inputElement) {
            inputElement.addEventListener('input', function (e) {
                // Yalnızca sayıları al
                let value = e.target.value.replace(/\D/g, '');

                // Nokta eklemek için formatlama
                let formattedValue = value
                    .split('')
                    .reverse()
                    .join('')
                    .match(/.{1,3}/g)
                    .join('.')
                    .split('')
                    .reverse()
                    .join('');

                // Formatlanmış değeri input alanına yaz
                e.target.value = formattedValue;
            });
        }



        // Distance ve AverageGasSpend alanlarına formatlama ekle
        formatNumberInput(document.getElementById('distance'));
        formatNumberInput(document.getElementById('averageGasSpend'));

    

        
        // Kaydırma işlemini ekleyen JavaScript fonksiyonu
        function handleSubmit(form) {
            // Sayfa gönderimi sonrası kaydırmayı etkinleştir
            setTimeout(() => {
                const resultSection = document.getElementById('result-section');
                if (resultSection) {
                    resultSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }, 500); // 500ms gecikme, sonucu beklemek için
            return true; // Form gönderimini devam ettir
        }
    </script>
    


    <footer>
        <p>© 2025 Gas Calculation. All Rights Reserved.</p>
    </footer>

    

   
</body>
</html>
