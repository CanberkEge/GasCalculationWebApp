@model GasCalculationWebApp.Model.UserViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="icon" type="image/x-icon" href="~/Pictures/GasStation.ico">
</head>
<body>
    <header>
        <div class="logo">
            <h1><i class="fas fa-user"></i> Profile</h1>
        </div>
    </header>

    <nav>
        <ul>
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("CarIndex", "Home")">Calculate by Car</a></li>
            @if (User.Identity.IsAuthenticated)
            {
                <li>Welcome, @User.Identity.Name!</li>
                <li><a href="@Url.Action("MyCars", "Car")">My Cars</a></li>
                <li><a href="@Url.Action("SaveCar", "Car")">Save Car</a></li>
                <li><a href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i> Profile</a></li>
                <li><a href="@Url.Action("Logout", "Account")">Logout</a></li>
            }
            else
            {
                <li><a href="@Url.Action("Login", "Account")">Login</a></li>
                <li><a href="@Url.Action("Register", "Account")">Register</a></li>
            }
        </ul>
    </nav>

    <section class="profile-section">
        <div class="form-container">
            <!-- Sol Taraf: Kullanıcı Bilgileri -->
            <div class="form-left">
                <h2><i class="fas fa-user-circle"></i> Profile Information</h2>
                <p>Your personal details.</p>
                <div class="form-group">
                    <label for="username"><i class="fas fa-id-badge"></i> Username:</label>
                    <input type="text" id="username" class="form-control" value="@User.Identity.Name" readonly />
                </div>
                <div class="form-group">
                    <label for="name"><i class="fas fa-user"></i> Name:</label>
                    <input type="text" id="name" class="form-control" value="@Model.Name" readonly />
                </div>
                <div class="form-group">
                    <label for="email"><i class="fas fa-envelope"></i> Email:</label>
                    <input type="email" id="email" class="form-control" value="@Model.Email" readonly />
                </div>
                <div class="form-group">
                    <label for="createdAt"><i class="fas fa-calendar-alt"></i> Registered On:</label>
                    <input type="text" id="createdAt" class="form-control" value="@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")" readonly />
                </div>
            </div>

            <!-- Sağ Taraf: Şifre Değiştirme Butonu -->
            <div class="form-right">
                <h2><i class="fas fa-key"></i> Security</h2>
                <p>Update your account security settings.</p>

                <!-- Change Password Sayfasına Yönlendiren Buton -->
                <div class="form-group">
                    <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-warning">
                        <i class="fas fa-key"></i> Change Password
                    </a>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <p>© 2025 Gas Calculation. All Rights Reserved.</p>
    </footer>
</body>
</html>
