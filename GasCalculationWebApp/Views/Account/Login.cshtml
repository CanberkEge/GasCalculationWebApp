<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="icon" type="image/x-icon" href="~/Pictures/GasStation.ico">
</head>
<body>
    <header>
        <div class="logo">
            <h1><i class="fas fa-car"></i> Login</h1>
        </div>
    </header>

    <nav>
        <ul>
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("CarIndex", "Home")">Calculate by Car</a></li>
            @if (User.Identity.IsAuthenticated)
            {
                <li>Welcome, @User.Identity.Name!</li>
                <li><a href="@Url.Action("MyCars", "Car")">My Cars</a></li>
                <li><a href="@Url.Action("SaveCar", "Car")">Save Car</a></li>
                <li><a href="@Url.Action("CompareCars", "Car")"><i class="fas fa-balance-scale"></i> Compare Cars</a></li>
                <li><a href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i> Profile</a></li>
                <li><a href="@Url.Action("Logout", "Account")">Logout</a></li>
            }
            else
            {
                <li><a href="@Url.Action("Login", "Account")">Login</a></li>
                <li><a href="@Url.Action("Register", "Account")">Register</a></li>
            }
        </ul>
    </nav>

    <section class="form-section">
        <div class="form-container">
            <div class="form-left">
                <h2><i class="fas fa-sign-in-alt"></i> Login to Your Account</h2>
                <p>Enter your credentials to access your account.</p>
            </div>
            <div class="form-right">
                <form asp-action="Login" method="post" class="form">
                    <div class="form-group">
                        <label for="identifier"><i class="fas fa-user"></i> Email or Username:</label>
                        <input type="text" id="identifier" name="identifier" class="form-control" placeholder="Enter your email or username" required />
                    </div>

                    <div class="form-group">
                        <label for="password"><i class="fas fa-lock"></i> Password:</label>
                        <div class="password-container">
                            <input type="password" id="password" name="Password" class="form-control" placeholder="Enter your password" required />
                            <i class="fas fa-eye" onclick="togglePassword('password', this)"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-sign-in-alt"></i> Login</button>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3">
                        @ViewBag.Error
                    </div>
                }
            </div>
        </div>
    </section>

    <footer>
        <p>© 2025 Gas Calculation. All Rights Reserved.</p>
    </footer>

    <script>
        function togglePassword(fieldId, icon) {
            var input = document.getElementById(fieldId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>